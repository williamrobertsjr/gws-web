{% extends "base.twig" %}
{% block content %}

{# {% include "page-header.twig" %} #}

{# Deep links (e.g. /products/#milling/steel/corner-chamfer) are filtered client-side after the
   page loads, so without this the visitor sees the full unfiltered grid flash by first. Hide the
   grids for hash URLs until product-index-filter.js has applied the filter (it removes the class);
   the timeout is a safety net so a script failure can never leave the page blank. Runs in the
   browser per visitor, so it's safe under the full-page cache. #}
<style>.pi-deeplink .tiles-grid{visibility:hidden}</style>
<script>
    if (location.hash.length > 1) {
        document.documentElement.classList.add('pi-deeplink');
        setTimeout(function () { document.documentElement.classList.remove('pi-deeplink'); }, 4000);
    }
</script>

<div class="container mx-auto py-20 px-4 md:px-0">
    <div class="w-8/12">
        <h1 class="text-6xl text-white font-black uppercase mb-4">Products</h1>
        <p class=" text-xl mb-24">GWS Tool Group engineers high-performance carbide cutting tools for industries that hold to exacting standards — aerospace, medical, defense, and more. Browse our full standard line below, or if you already know exactly what you need, use our <a class="text-pale-blue underline" href="products/milling/">Tool Filter</a> to search by exact specifications or head to <a class="text-pale-blue underline" href="/rapid-quote">Rapid Quote</a> to get pricing in minutes.</p>
    </div>
    <div class="pi-category-tabs flex flex-wrap gap-4 mb-12">
        {% for category in product_index_categories %}
            <button type="button" class="text-pale-blue text-md pi-tab-btn{% if loop.first %} is-checked{% endif %}" data-pi-tab="{{ category.category_slug }}">{{ category.category }}</button>
        {% endfor %}

    </div>
    {# <hr class="text-white mb-8"> #}
    {% for category in product_index_categories %}
        <div class="pi-tab-panel{% if not loop.first %} hidden{% endif %}" data-pi-tab="{{ category.category_slug }}">
            {% include 'product-index-category.twig' with {'category': category} %}
        </div>
    {% endfor %}
</div>


<script src="https://unpkg.com/isotope-layout@3.0.6/dist/isotope.pkgd.min.js" defer></script>
<script src="{{ site.theme.link }}/assets/js/product-index-filter.js" defer></script>
{% endblock %}
