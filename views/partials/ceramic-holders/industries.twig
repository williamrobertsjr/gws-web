{# 6 · Industries: photo tiles with a bottom gradient for legibility. #}
{% import 'partials/ceramic-holders/macros.twig' as ui %}

<section class="bg-main-bg px-4 py-20 md:px-10 lg:py-32">
    <div class="mx-auto flex max-w-[1504px] flex-col gap-12 lg:gap-14">
        <div class="flex flex-col gap-5" data-reveal>
            {{ ui.eyebrow('Where ceramic turning runs') }}
            {{ ui.heading('Industries') }}
        </div>

        <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {% for industry in cth.industries %}
                <li data-reveal class="mb-0 relative flex h-[380px] flex-col justify-end overflow-hidden rounded bg-[#2b2b2b] px-7 pb-7 pt-6">
                    {{ ui.img(industry.image, 'absolute inset-0 h-full w-full object-cover', '(min-width: 1024px) 486px, (min-width: 768px) 50vw, 100vw') }}
                    <div aria-hidden="true" class="absolute inset-0 bg-gradient-to-b from-transparent via-[rgba(0,0,0,0.05)] via-45% to-[rgba(0,0,0,0.85)]"></div>
                    <div class="relative flex flex-col gap-2">
                        <h3 class="text-[26px] font-black uppercase leading-[1.1] text-white">{{ industry.title }}</h3>
                        <p class="text-base font-light leading-[1.45] text-pale-blue">{{ industry.description }}</p>
                    </div>
                </li>
            {% endfor %}
        </ul>
    </div>
</section>
