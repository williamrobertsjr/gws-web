{# 1 · Hero: headline, spec chips, CTAs, product photo and stat strip.
   Also used on the homepage. Optional variables (all default to the landing page's behaviour):
   hero_intro (string), hero_show_stats (bool), hero_buttons (list of {label, href, variant}), hero_extra (template included below the copy). #}
{% import 'partials/ceramic-holders/macros.twig' as ui %}

{% set hero_show_stats = hero_show_stats is defined ? hero_show_stats : true %}
{% set hero_buttons = hero_buttons is defined ? hero_buttons : [
    {label: 'View products', href: '#product-families', variant: 'dark-blue'},
    {label: 'Talk to a specialist', href: '#contact-specialist', variant: 'light-blue'},
] %}
{% set stats = [
    {value: '9', label: 'Holder styles'},
    {value: '3', label: 'Clamping systems'},
    {value: '3', label: 'Insert shapes: round, rhombic, square'},
    {value: '~1 wk', label: 'Typical lead time on non-stocked holders'},
] %}

<section class="relative flex flex-col justify-between overflow-hidden bg-[linear-gradient(55deg,#03142c_11%,#0b3a78_54%,#1f63c0_89%)] lg:min-h-[900px]">
    {# Legibility overlay: darkens the left side behind the copy. #}
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 bg-gradient-to-r from-[#020b18]/85 via-[#020b18]/45 via-50% to-[#020b18]/0 to-75%"></div>

    <div class="relative px-4 pb-16 pt-16 md:px-10 lg:pt-[120px]">
        <div class="mx-auto flex max-w-[1504px] flex-col-reverse gap-10 lg:flex-row lg:items-center lg:gap-6">
            <div class="flex min-w-0 flex-col items-start gap-6 lg:max-w-[940px] lg:flex-1">
                {{ ui.chip('New', 'solid') }}

                <h1 class="flex flex-col gap-1 uppercase">
                    <span class="text-3xl font-normal leading-[1.1] text-pale-blue md:text-5xl">Toolholders for</span>
                    <span class="text-5xl font-black leading-[0.98] tracking-[-0.01em] text-white md:text-7xl xl:text-[84px]">Ceramic Turning Inserts</span>
                </h1>

                <p class="max-w-[760px] text-xl font-light italic leading-[1.45] text-pale-blue md:text-2xl">{{ hero_intro is defined ? hero_intro : 'Nine holder styles matched to GWS ceramic inserts, with dimple lock and coolant-through options.' }}</p>

                <ul class="flex flex-wrap gap-2" aria-label="Key specifications">
                    {% for spec in ['Ceramic', 'Round · Rhombic · Square', '3 clamping systems', 'Coolant through'] %}
                        <li class="pl-0 mb-0">{{ ui.chip(spec) }}</li>
                    {% endfor %}
                </ul>

                <div class="flex flex-wrap gap-3 pt-3">
                    {% for button in hero_buttons %}
                        {{ ui.button(button.label, button.href, button.variant) }}
                    {% endfor %}
                </div>
            </div>

            {% if cth.hero_image %}
                <div class="w-full max-w-[500px] self-center lg:max-w-[450px] xl:max-w-[550px] lg:shrink-0 lg:self-start">
                    {{ ui.img(cth.hero_image, 'h-auto w-full object-contain', '(min-width: 1024px) 619px, 100vw', true) }}
                </div>
            {% endif %}
        </div>
        {% if hero_extra is defined %}
            <div class="mx-auto max-w-[1504px]">{% include hero_extra %}</div>
        {% endif %}
    </div>

    {% if hero_show_stats %}
    <div class="relative border-t border-pale-blue/20 bg-[#020b18]/60 px-4 pb-10 pt-9 md:px-10">
        <dl class="mx-auto grid max-w-[1504px] grid-cols-2 gap-x-6 gap-y-8 lg:grid-cols-4">
            {% for stat in stats %}
                <div class="flex flex-col-reverse gap-1.5">
                    <dt class="max-w-[280px] text-sm font-normal leading-[1.4] text-pale-blue">{{ stat.label }}</dt>
                    <dd class="whitespace-nowrap text-5xl font-black leading-none text-white">{{ stat.value }}</dd>
                </div>
            {% endfor %}
        </dl>
    </div>
    {% endif %}
</section>
