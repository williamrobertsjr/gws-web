{# One holder family card. The whole card links to the family's first series page (stretched
   "View products" link); each series code in the footer links to its own series page. #}
{% import 'partials/ceramic-holders/macros.twig' as ui %}

<li data-reveal class="pl-0 mb-0 relative flex flex-col overflow-hidden rounded bg-[#2b2b2b] shadow-xl" data-cth-shape="{{ family.shape }}">
    <div class="flex h-[300px] items-center justify-center bg-gradient-to-b from-[#f4f5f7] to-[#dfe3e8]">
        {{ ui.img(family.image, 'h-full w-full object-contain', '(min-width: 1024px) 400px, (min-width: 768px) 50vw, 100vw') }}
    </div>

    <div class="flex flex-1 flex-col gap-3.5 p-7">
        <h3 class="flex flex-wrap items-baseline gap-x-3 text-3xl leading-normal">
            <span class="font-black uppercase text-white">{{ family.code }}</span>
            {% if family.angle %}<span class="font-light text-pale-blue">{{ family.angle }}</span>{% endif %}
        </h3>

        <p class="text-base font-light leading-normal text-[#b9c0c8]">{{ family.description }}</p>

        <ul class="flex flex-wrap gap-1.5">
            {% for chip in family.chips %}
                <li class="pl-0 mb-0">{{ ui.chip(chip) }}</li>
            {% endfor %}
            {% if family.coolant %}
                <li class="pl-0 mb-0">{{ ui.chip('Coolant through', 'pale') }}</li>
            {% endif %}
        </ul>

        <p class="text-[13px] font-medium leading-normal tracking-[0.04em] text-[#b9c0c8]">Inserts: {{ family.inserts }}</p>

        <div class="mt-auto flex flex-col gap-3.5">
            <div class="h-px bg-white/[0.12]"></div>
            <div class="flex items-center justify-between gap-4 whitespace-nowrap">
                <a href="/series-{{ family.series|first }}/" class="text-[15px] font-semibold leading-normal text-pale-blue after:absolute after:inset-0 hover:underline">View products <span aria-hidden="true">→</span><span class="sr-only"> for {{ family.code }}</span></a>
                <p class="relative text-[13px] font-medium leading-normal text-[#b9c0c8]">
                    Series
                    {% for series in family.series %}
                        <a href="/series-{{ series }}/" class="text-[#b9c0c8] hover:text-pale-blue hover:underline">{{ series }}</a>{% if not loop.last %} · {% endif %}
                    {% endfor %}
                </p>
            </div>
        </div>
    </div>
</li>
