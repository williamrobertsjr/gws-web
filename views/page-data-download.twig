{% extends "base.twig" %}
{% block content %}

<section class="px-4 py-20">
    <div class="container mx-auto">

        <h1 class="text-4xl font-black uppercase text-white mb-2">GWS Tool Pricing</h1>

        {% if isPrivileged %}
            <p class="text-gray-400 mb-1">Use the <strong>Discount Tier</strong> selector at the top of the page to change the pricing shown below and in your download.</p>
        {% else %}
            <p class="text-gray-400 mb-1">Your pricing tier: <strong class="text-white">{{ tierLabel }}</strong></p>
        {% endif %}
        <p class="text-gray-400 mb-6">Last updated: <strong class="text-white">{{ priceEffectiveDate }}</strong></p>

        <div class="flex justify-end mb-4">
            <button id="download-csv" class="btn dark-blue">Download CSV<i class="fa-solid fa-download ms-2"></i></button>
        </div>

        <div id="parts-price-table-wrapper" class="w-full overflow-x-auto bg-white p-8">
            <p class="text-black mb-4">Below is the list of parts and pricing information. Use the table to view details and download the CSV as needed.</p>
            <table id="parts-price-table" class="!w-full stripe row-border cell-border hover dark filter-border">
                <thead>
                    <tr>
                        <th>Part</th>
                        <th>Series</th>
                        <th>Tool Type</th>
                        <th>Family</th>
                        <th>Brand</th>
                        <th>Description</th>
                        <th>List Price</th>
                        <th>Net Price</th>
                        <th>Qty 1+</th>
                        <th>Qty 2+</th>
                        <th>Qty 3+</th>
                        <th>Qty 6+</th>
                        <th>Qty 9+</th>
                        <th>Qty 12+</th>
                        <th>Qty 24+</th>
                        <th>Qty 48+</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- DataTables will populate via AJAX -->
                </tbody>
            </table>
        </div>

    </div>
</section>

{% endblock %}
